generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Produto {
  id         Int      @id @default(autoincrement())
  nome       String
  descricao  String?
  preco      Float
  quantidade Int
  status     Boolean  @default(true)
  criadoEm   DateTime @default(now())
}
